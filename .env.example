# TMDB API Read Access Token (Bearer token). Copy to .env.local and fill in locally.
TMDB_READ_ACCESS_TOKEN=your_tmdb_read_access_token_here

# Optional import bounds. Defaults: 1 page each, 10 cast members per title, 500 output records.
TMDB_MOVIE_PAGES=1
TMDB_TV_PAGES=1
TMDB_CAST_LIMIT=10
TMDB_MAX_CHARACTERS=500
